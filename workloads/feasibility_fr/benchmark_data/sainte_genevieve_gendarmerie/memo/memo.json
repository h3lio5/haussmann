{
  "sections": [
    {
      "id": "site",
      "hash": "e2159d3e96c1f7c15ac0a9c01806579458ce527649449de7287cc2e7ad67328c",
      "sentences": [
        {
          "text": "Le terrain objet du dossier présente une contenance de {site.land_area}.",
          "uses": [
            "site.land_area"
          ]
        },
        {
          "text": "Le propriétaire du bien est la {site.owner}.",
          "uses": [
            "site.owner"
          ]
        },
        {
          "text": "La référence cadastrale du terrain est {site.parcel_ref}.",
          "uses": [
            "site.parcel_ref"
          ]
        },
        {
          "text": "Le terrain se situe en zone {site.zone} selon le plan local d'urbanisme.",
          "uses": [
            "site.zone"
          ]
        }
      ]
    },
    {
      "id": "rules",
      "hash": "0523c4a8cbd2768ad924e0508a31ded259eed6507c1d9dc0b97a0d7672e4c57e",
      "sentences": [
        {
          "text": "L'emprise au sol maximale autorisée est de {site.footprint_limit}.",
          "uses": [
            "site.footprint_limit"
          ]
        },
        {
          "text": "La hauteur maximale autorisée est de {site.max_height}.",
          "uses": [
            "site.max_height"
          ]
        },
        {
          "text": "Le nombre de niveaux maximal autorisé est de {site.max_levels}.",
          "uses": [
            "site.max_levels"
          ]
        },
        {
          "text": "Un recul de {site.street_setback} est imposé sur la rue.",
          "uses": [
            "site.street_setback"
          ]
        },
        {
          "text": "Le certificat d'urbanisme a été délivré le {site.planning_certificate_date} (à vérifier pour son actualité).",
          "uses": [
            "site.planning_certificate_date"
          ]
        }
      ]
    },
    {
      "id": "risks",
      "hash": "bd099800ef5b7472eb9e1b5aeb2a6ad62d3e76cd1fc5e9e2b7b2d9357726958b",
      "sentences": [
        {
          "text": "Le bien objet du dossier - Risque d'inondation : {site.flood_risk}.",
          "uses": [
            "site.flood_risk"
          ]
        }
      ]
    },
    {
      "id": "occupancy",
      "hash": "e3f0e8a0b07997d82a24a4d009bc49b9e1ff6509c26473e617bcff5a316b82a0",
      "sentences": [
        {
          "text": "La convention d'antenne relais génère un loyer annuel de {lease:antenne.annual_rent}.",
          "uses": [
            "lease:antenne.annual_rent"
          ]
        },
        {
          "text": "La convention avec l'association sportive affiche un loyer annuel de {lease:association.annual_rent} avec une échéance au {lease:association.lease_end}.",
          "uses": [
            "lease:association.annual_rent",
            "lease:association.lease_end"
          ]
        },
        {
          "text": "Le bail de l'atelier présente un loyer annuel de {lease:atelier.annual_rent} et une échéance au {lease:atelier.lease_end}.",
          "uses": [
            "lease:atelier.annual_rent",
            "lease:atelier.lease_end"
          ]
        },
        {
          "text": "La location du garage correspond à un loyer annuel de {lease:garage.annual_rent} avec une échéance au {lease:garage.lease_end}.",
          "uses": [
            "lease:garage.annual_rent",
            "lease:garage.lease_end"
          ]
        },
        {
          "text": "Le bail du logement indique un loyer annuel de {lease:logement.annual_rent} et une échéance au {lease:logement.lease_end}.",
          "uses": [
            "lease:logement.annual_rent",
            "lease:logement.lease_end"
          ]
        },
        {
          "text": "Le total des loyers annuels s'élève à {loyers.annual_rent}.",
          "uses": [
            "loyers.annual_rent"
          ]
        }
      ]
    },
    {
      "id": "areas",
      "hash": "f591a534e0791370138251f657d0eeac30044416f9117cbaec3629e3fb49d0db",
      "sentences": [
        {
          "text": "La surface de plancher des bureaux et locaux techniques est de {floor:bureaux.floor_area}.",
          "uses": [
            "floor:bureaux.floor_area"
          ]
        },
        {
          "text": "Les logements du bâtiment principal occupent {floor:logements.floor_area}.",
          "uses": [
            "floor:logements.floor_area"
          ]
        },
        {
          "text": "Le pavillon indépendant présente une surface de {floor:pavillon.floor_area}.",
          "uses": [
            "floor:pavillon.floor_area"
          ]
        },
        {
          "text": "Le total des surfaces de plancher s'élève à {batiment.floor_area} (signalé).",
          "uses": [
            "batiment.floor_area"
          ]
        }
      ]
    },
