    {
      "id": "site",
      "hash": "83fd8ceba52884d14c550990577fbb4ded9a9b99378c1c9e9975779e045458ee",
      "sentences": [
        {
          "text": "Le terrain objet du dossier présente une contenance de {site.land_area}.",
          "uses": [
            "site.land_area"
          ]
        },
        {
          "text": "Le propriétaire du terrain est la {site.owner}.",
          "uses": [
            "site.owner"
          ]
        },
        {
          "text": "La référence cadastrale du terrain est {site.parcel_ref}.",
          "uses": [
            "site.parcel_ref"
          ]
        },
        {
          "text": "Le terrain est situé en zone {site.zone}.",
          "uses": [
            "site.zone"
          ]
        }
      ]
    },
    {
      "id": "rules",
      "hash": "62a9f98cb7387562794ce4b9760c2bf2a34dc7adeb998ad4e3f483af2cc027f8",
      "sentences": [
        {
          "text": "L'emprise au sol maximale autorisée est de {site.footprint_limit}.",
          "uses": [
            "site.footprint_limit"
          ]
        },
        {
          "text": "La hauteur maximale autorisée est de {site.max_height}.",
          "uses": [
            "site.max_height"
          ]
        },
        {
          "text": "Le nombre de niveaux maximal autorisé est de {site.max_levels}.",
          "uses": [
            "site.max_levels"
          ]
        },
        {
          "text": "Le recul sur rue imposé est de {site.street_setback}.",
          "uses": [
            "site.street_setback"
          ]
        },
        {
          "text": "Le certificat d'urbanisme a été délivré le {site.planning_certificate_date}.",
          "uses": [
            "site.planning_certificate_date"
          ]
        }
      ]
    },
    {
      "id": "risks",
