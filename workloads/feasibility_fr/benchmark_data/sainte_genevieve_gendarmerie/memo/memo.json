      "sentences": [
        {
          "text": "Le dossier établit un risque d'inondation pour le bien objet du dossier, signalé {site.flood_risk}.",
          "uses": [
            "site.flood_risk"
          ]
        }
      ]
    },
    {
      "id": "occupancy",
      "hash": "cb845a757d971e24a1ca4f279bdd2107745bc57c46053bb941fb098d8ed4fd83",
      "sentences": [
        {
          "text": "La convention d'antenne relais génère un loyer annuel de {lease:antenne.annual_rent}.",
          "uses": [
            "lease:antenne.annual_rent"
          ]
        },
        {
          "text": "La convention avec l'association sportive génère un loyer annuel de {lease:association.annual_rent} et son échéance est fixée au {lease:association.lease_end}.",
          "uses": [
            "lease:association.annual_rent",
            "lease:association.lease_end"
          ]
        },
        {
          "text": "Le bail de l'atelier génère un loyer annuel de {lease:atelier.annual_rent} et son échéance est fixée au {lease:atelier.lease_end}.",
          "uses": [
            "lease:atelier.annual_rent",
            "lease:atelier.lease_end"
          ]
        },
        {
          "text": "La location du garage génère un loyer annuel de {lease:garage.annual_rent} et son échéance est fixée au {lease:garage.lease_end}.",
          "uses": [
            "lease:garage.annual_rent",
            "lease:garage.lease_end"
          ]
        },
        {
          "text": "Le bail du logement génère un loyer annuel de {lease:logement.annual_rent} et son échéance est fixée au {lease:logement.lease_end}.",
          "uses": [
            "lease:logement.annual_rent",
            "lease:logement.lease_end"
          ]
        },
        {
          "text": "Le total des loyers annuels s'élève à {loyers.annual_rent}.",
          "uses": [
            "loyers.annual_rent"
          ]
        }
      ]
    },
    {
