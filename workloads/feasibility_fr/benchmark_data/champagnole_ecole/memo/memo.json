            "site.zone"
          ]
        }
      ]
    },
    {
      "id": "rules",
      "hash": "ad5a39f576307fe37c8bbf4318af0e9e9947e24510e059fd3fb761dd791ab581",
      "sentences": [
        {
          "text": "Le nombre maximal de niveaux autorisés par les règles d'urbanisme est de {site.max_levels}.",
          "uses": [
            "site.max_levels"
          ]
        },
        {
          "text": "Un recul minimal de {site.street_setback} est imposé en bordure de voie.",
          "uses": [
            "site.street_setback"
          ]
        },
        {
          "text": "Le certificat d'urbanisme en vigueur a été délivré le {site.planning_certificate_date}.",
