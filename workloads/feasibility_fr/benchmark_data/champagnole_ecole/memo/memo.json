            "floor:r1.floor_area"
          ]
        },
        {
          "text": "Le rez-de-chaussée occupe {floor:rdc.floor_area}.",
          "uses": [
            "floor:rdc.floor_area"
          ]
        },
        {
          "text": "Le sous-sol contribue à hauteur de {floor:sous_sol.floor_area}.",
          "uses": [
            "floor:sous_sol.floor_area"
          ]
        }
      ]
    },
