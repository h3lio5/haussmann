    {
      "id": "occupancy",
      "hash": "c67dcbc1f4197446195265d743e8a2751d05b974cba39196ed815025c225abb4",
      "sentences": [
        {
          "text": "L'atelier occupe le site avec un loyer annuel de {lease:atelier.annual_rent}.",
          "uses": [
            "lease:atelier.annual_rent"
          ]
        },
        {
          "text": "L'échéance du bail de l'atelier est prévue pour le {lease:atelier.lease_end}.",
          "uses": [
            "lease:atelier.lease_end"
          ]
        },
        {
          "text": "Le club associatif occupe le site avec un loyer annuel de {lease:club.annual_rent}.",
          "uses": [
            "lease:club.annual_rent"
          ]
        },
        {
          "text": "L'échéance du bail du club associatif est prévue pour le {lease:club.lease_end}.",
          "uses": [
            "lease:club.lease_end"
          ]
        },
        {
          "text": "Le total des loyers annuels perçus s'élève à {loyers.annual_rent}.",
          "uses": [
            "loyers.annual_rent"
          ]
        }
      ]
    },
    {
