      "id": "site",
      "hash": "d18d32bbd144da82c84680a0e665fc470cdc7dd2503a57373bcf09a2702cda82",
      "sentences": [
        {
          "text": "Le terrain objet du dossier présente une référence cadastrale de {site.parcel_ref}.",
          "uses": [
            "site.parcel_ref"
          ]
        },
        {
          "text": "Sa contenance est de {site.land_area}.",
